# Copy to .env and fill in. Never commit .env.
# Secrets are read at deploy time via secret()/env() in infra/ and by scripts/.

# Cargo workspace API token (Workspace settings > API tokens). cargo-ai reads
# this name, and so do the MCP configs (.mcp.json, .cursor/mcp.json, .codex).
CARGO_API_TOKEN=

# LLM provider key for local evals (promptfoo)
OPENAI_API_KEY=

# infra/ deploys need no other secrets: models are native and connectors are
# adopted (configured in the workspace UI). Add a secret here only when you wire
# a connector with secret("NAME") (e.g. a CRM), matching the name you reference.
